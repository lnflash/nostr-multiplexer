# Port the HTTP server listens on (default 4000)
PORT=4000

# Upstream Flash GraphQL endpoint used for NIP-05 username -> npub resolution.
# REQUIRED — the service fails to start if this is unset.
GRAPHQL_URL=

# Environment: staging | production | test (default: production)
NODE_ENV=production

# Number of proxy hops to trust for client-IP derivation (rate limiting).
# Leave unset/false when the app is internet-facing directly. Set to the number
# of proxies in front of the app (e.g. 1) when behind a load balancer / ingress.
TRUST_PROXY=
